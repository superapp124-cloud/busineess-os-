<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shield_bg">

    <!-- Blurred background avatar -->
    <ImageView
        android:id="@+id/backgroundBlurImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.25"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top spacer for status bar -->
    <Space
        android:id="@+id/topSpacer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Call Badge (Image 2 Screen 3) -->
    <LinearLayout
        android:id="@+id/shieldHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/button_rounded_glass"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/topSpacer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sparkle"
            app:tint="#A78BFA" />
            
        <TextView
            android:id="@+id/shieldTrustBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="CHATR Call"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Caller Avatar -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/shieldHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <View
            android:id="@+id/pulseRing1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_shield_pulse_ring" />

        <ImageView
            android:id="@+id/callerAvatarImage"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_shield_pulse_ring"
            android:scaleType="centerCrop" />
            
        <TextView
            android:id="@+id/callerInitialText"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/shield_text_primary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Caller Details -->
    <TextView
        android:id="@+id/callerNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:text="Rahul Mehta"
        android:textColor="@color/shield_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/avatarContainer" />

    <TextView
        android:id="@+id/callerPhoneText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="+91 98765 43210"
        android:textColor="@color/shield_text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/callerNameText" />

    <!-- SI Caller Intelligence Card (Image 2 Screen 3) -->
    <LinearLayout
        android:id="@+id/callerIntelligenceCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ai_card_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/callerPhoneText">

        <ImageView
            android:id="@+id/intelligenceIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="@drawable/button_rounded_glass"
            android:backgroundTint="#2E1065"
            android:src="@drawable/ic_shield_check"
            app:tint="#C084FC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/intelligenceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Likely a contact"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/intelligenceDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Co-founder at Innovex • Bangalore, India"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3 Quick Triage Action Buttons (Image 2 Screen 3) -->
    <LinearLayout
        android:id="@+id/quickTriageBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/callerIntelligenceCard">

        <!-- 1. Remind Button -->
        <LinearLayout
            android:id="@+id/btnRemind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="@drawable/button_rounded_glass"
                android:src="@drawable/ic_notifications"
                app:tint="#CBD5E1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Remind"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Message Button -->
        <LinearLayout
            android:id="@+id/btnMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="@drawable/button_rounded_glass"
                android:src="@drawable/ic_message"
                app:tint="#CBD5E1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Message"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. SI Screen Button (Flagship) -->
        <LinearLayout
            android:id="@+id/btnAiScreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:background="@drawable/button_rounded_glass"
                android:backgroundTint="#3B0764"
                android:src="@drawable/ic_sparkle"
                app:tint="#A855F7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="SI Screen"
                android:textColor="#C084FC"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Answer & Decline Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnDecline"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_shield_pulse_ring"
            android:backgroundTint="@color/shield_decline"
            android:gravity="center"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_call_end"
                app:tint="@color/shield_text_primary" />
        </LinearLayout>

        <Space
            android:layout_width="64dp"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/btnAnswer"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_shield_pulse_ring"
            android:backgroundTint="@color/shield_accept_start"
            android:gravity="center"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_call"
                app:tint="@color/shield_text_primary" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
