<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_bg"
        android:padding="24dp"
        android:elevation="16dp">

        <!-- Top Header: Subdued title, no tech jargon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Call summary"
                android:textColor="#9CA3AF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/urgencyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DC2626"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Caller Name -->
        <TextView
            android:id="@+id/callerNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginBottom="8dp"/>

        <!-- Executive Natural Summary -->
        <TextView
            android:id="@+id/summaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Summarizing call..."
            android:textColor="#E5E7EB"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.25"
            android:layout_marginBottom="16dp"/>

        <!-- Key Points / Discussion section -->
        <TextView
            android:id="@+id/keyPointsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Key points"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/keyPointsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D1D5DB"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="16dp"/>

        <!-- Commitments Section -->
        <LinearLayout
            android:id="@+id/commitmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1F2937"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/commitmentsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Commitment detected"
                android:textColor="#60A5FA"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/commitmentsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F3F4F6"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.2"/>
        </LinearLayout>

        <!-- Suggested Action Chips (Add to calendar, Save commitment, Call back, Send message) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="20dp">
            
            <LinearLayout
                android:id="@+id/actionChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Done Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Done"
            android:textColor="#FFFFFF"
            app:backgroundTint="#374151"
            app:cornerRadius="24dp"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>

</FrameLayout>
