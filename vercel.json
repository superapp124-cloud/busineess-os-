{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "bun install",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/download/Chatr-Plus.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Chatr-Plus.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/download/chatr.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Chatr-Plus.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/apk",
      "destination": "/download/Chatr-Plus.apk",
      "permanent": false
    },
    {
      "source": "/download/chatr-android.apk",
      "destination": "/download/Chatr-Plus.apk",
      "permanent": false
    },
    {
      "source": "/download/android/apk",
      "destination": "/download/Chatr-Plus.apk",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "chatrchat.in"
        }
      ],
      "destination": "https://www.chatrchat.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/download/Chatr-Plus.apk",
      "destination": "/download/Chatr-Plus.apk"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
