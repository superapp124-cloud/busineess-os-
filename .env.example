# CHATR OS — Environment Configuration Matrix
# Copy this file to .env or .env.local for local development.

# ============================================
# Firebase Authentication & Push Notifications
# https://console.firebase.google.com/
# ============================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# ============================================
# Supabase Backend
# https://supabase.com/dashboard
# ============================================
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# ============================================
# Supabase Edge Function Secrets
# Set via `supabase secrets set KEY=VALUE`
# ============================================
FIREBASE_PROJECT_ID=chatr-91067
JWT_SIGNING_SECRET=your_supabase_jwt_secret
CHATR_ALLOWED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085,https://chatr.chat,https://www.chatr.chat

# ============================================
# OAuth Connectors (Service Integration Only)
# ============================================
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_MICROSOFT_CLIENT_ID=your_microsoft_app_client_id
VITE_OUTLOOK_CLIENT_ID=your_microsoft_app_client_id
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id

# ============================================
# AI Models & Services
# ============================================
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_OPENAI_API_KEY=your_openai_api_key
VITE_SEARCH_API_URL=https://search.chatr.chat

# ============================================
# Signaling & Realtime Governance
# ============================================
VITE_ENABLE_SOCKET=true
VITE_SIGNALING_ENV=auto
VITE_ALLOW_LOCAL_SOCKET_AUTO=false
VITE_SOCKET_URL=
VITE_WEBTRANSPORT_URL=

# ============================================
# Search Pipeline (Backend / Node Service)
# ============================================
SEARCH_SERVER_PORT=8787
BRAVE_SEARCH_API_KEY=your_brave_search_key
GEMINI_API_KEY=your_google_ai_studio_key
GROQ_API_KEY=your_groq_key
TOGETHER_API_KEY=your_together_key_optional
SEARCH_PRIMARY_PROVIDER=gemini
SEARCH_STREAM_MODE=parallel
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
SEARCH_CACHE_TTL_MS=300000
CHATR_CURRENT_DATE=Friday, May 22, 2026
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# UDX — Universal Discovery OS  (SERVER-SIDE ONLY SECTION)
# All vars below are server-side. NEVER prefix with VITE_.
# GSC tokens must NEVER reach the browser.
# ============================================================

# ─── Google Search Console OAuth ─────────────────────────────
# OPTION A: Service Account (preferred for background workers)
# Create at: console.cloud.google.com → IAM → Service Accounts
# Grant access: add service account email as Owner in GSC property
GOOGLE_SERVICE_ACCOUNT_EMAIL=udx-gsc@your-project.iam.gserviceaccount.com
# Paste the full private key from your JSON key file, \n for newlines
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# OPTION B: OAuth2 Refresh Token
# Generate at developers.google.com/oauthplayground
# Scope: https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_long_lived_refresh_token

# ─── GSC Property IDs ─────────────────────────────────────────
# Must match property as shown in Google Search Console UI exactly
UDX_GSC_PROPERTY_TALENTXCEL=sc-domain:talentxcel.in
UDX_GSC_PROPERTY_CHATR=sc-domain:chatrchat.in

# ─── Supabase — TalentXcel database (SERVER-SIDE ONLY) ───────
# Project: dthlgsnakhoftinssokm  |  URL: https://dthlgsnakhoftinssokm.supabase.co
# Get service role key: supabase.com/dashboard/project/dthlgsnakhoftinssokm/settings/api
TALENTXCEL_SERVICE_ROLE_KEY=your_talentxcel_service_role_key_here

# Supabase — CHATR database (separate project)
# CHATR_SERVICE_ROLE_KEY=your_chatr_service_role_key_here


# ─── Ollama (local inference — PRIMARY, zero cost) ────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3:8b-instruct

# ─── Social API Connectors (Phase 2 — permissioned only) ──────
YOUTUBE_API_KEY=AIza...
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REFRESH_TOKEN=your_reddit_refresh_token
LINKEDIN_CLIENT_ID=your_li_client_id
LINKEDIN_CLIENT_SECRET=your_li_client_secret
LINKEDIN_ACCESS_TOKEN=your_li_access_token
TIKTOK_CLIENT_KEY=your_tt_client_key
TIKTOK_ACCESS_TOKEN=your_tt_access_token

# ─── UDX Core Loop ────────────────────────────────────────────
# Tenants to sync on each loop run (comma-separated)
UDX_SYNC_TENANT_IDS=talentxcel,chatr
# Cron for automatic sync (every 6 hours)
UDX_SYNC_SCHEDULE_CRON="0 */6 * * *"
# Minimum statistical confidence before concluding an experiment
UDX_MIN_EXPERIMENT_CONFIDENCE=0.90
# Auto-conclude experiments after this many days
UDX_MAX_EXPERIMENT_DAYS=28
# Policy version — must match PolicyEngine constant
UDX_POLICY_VERSION=v1.0.0

